easyblock = 'EB_ESPResSo'

name = 'ESPResSo'
version = '%(software_commit)s'

homepage = 'https://espressomd.org/wordpress'
description = """A software package for Molecular Dynamics and Monte Carlo
simulations of bead-spring models, with electrostatics, magnetostatics,
hydrodynamics and reaction-diffusion-advection solvers."""

sources = [
    {
    'source_urls': ['https://github.com/espressomd/espresso/archive/'],
    'filename': 'espresso-%(software_commit)s.tar.gz',
    'download_filename': '%(software_commit)s.tar.gz',
    },
    {
        'source_urls': ['https://github.com/lssfau/walberla/archive/623a60c1'],
        'filename': 'walberla-623a60c1.tar.gz',
        'download_filename': 'walberla-623a60c17e5d41bfee65148ab19703aa7811664b.tar.gz',
    },
]
checksums = [
    {'espresso-%(software_commit)s.tar.gz': None},
    {'walberla-623a60c1.tar.gz': None},
]

toolchain = {'name': 'foss', 'version': '2025a'}
toolchainopts = {'openmp': True, 'usempi': True, 'pic': True}

builddependencies = [
    ('CMake', '3.31.3'),
    ('Ninja', '1.12.1'),
    ('Cython', '3.1.1'),
]

dependencies = [
    ('Python', '3.13.1'),
    ('SciPy-bundle', '2025.06'),
    ('Boost.MPI', '1.88.0'),
    ('HeFFTe', '2.4.1'),
    ('Kokkos', '5.0.2'),
#    ('Cabana', '0.8.0'),
#    ('kokkos-fft', '2.0.0'),
    ('Mesa', '25.1.3'),
    ('GSL', '2.8'),
    ('NLopt', '2.10.0'),
    ('IPython', '9.3.0'),
    ('Pint', '0.24.4'),
    ('HDF5', '1.14.6'),
    ('h5py', '3.14.0'),
    ('HighFive', '3.3.0'),
    ('VTK', '9.5.0'),
]
if 'versionsuffix' in globals() and 'CUDA' in versionsuffix:
    dependencies += [
        ('CUDA', '12.8.0', '', SYSTEM),
    ]

moduleclass = 'chem'
